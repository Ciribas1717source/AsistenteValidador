# =====================================================================
# Asistente de Consulta y Validador de Historias de Usuario
# Copiar este archivo a ".env" (en la raíz del proyecto) y completar los valores.
# NUNCA commitear el .env. Ninguna de estas variables llega al frontend.
# Guardar el archivo en UTF-8 (las rutas tienen tildes).
# =====================================================================

# --- Servidor --------------------------------------------------------
PORT=4000
# Solo se acepta 127.0.0.1, localhost o ::1: la app NO queda expuesta a la red local.
HOST=127.0.0.1
# Origen del frontend de Vite en desarrollo (no cambiar salvo que cambies el puerto 5173)
CORS_ORIGIN=http://localhost:5173
# Timeout por request a APIs externas (ms) y reintentos para errores transitorios
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=2

# --- Inicio de sesión ------------------------------------------------
# local     -> usuario y contraseña propios de la app (sin Microsoft). RECOMENDADO por ahora.
# microsoft -> Microsoft Entra ID (requiere la sección "Microsoft" más abajo).
AUTH_MODE=local
# Archivo de usuarios locales (solo hashes scrypt). Vacío = data/local-users.json en la raíz.
# El usuario se crea con:  npm run user:create
LOCAL_AUTH_USERS_FILE=
# Bloqueo temporal tras intentos fallidos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Sesiones (cookie HttpOnly + SameSite; los datos de sesión quedan solo en el backend)
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=10
# true solo si la app se publica por HTTPS (en localhost con http debe quedar en false)
COOKIE_SECURE=false

# --- Fuente documental -----------------------------------------------
# local      -> carpeta de esta computadora (p. ej. sincronizada por OneDrive). Sin Microsoft Graph.
# demo       -> documentos ficticios etiquetados DEMO (para mostrar los 4 estados de validación).
# sharepoint -> SharePoint en línea vía Microsoft Graph (requiere AUTH_MODE=microsoft).
DOCS_SOURCE=local
# Ruta ABSOLUTA de la carpeta raíz. Sin comillas; se aceptan espacios, tildes y barras \ o /.
LOCAL_DOCS_ROOT=C:\Users\CarolinaIribas\ACCIONA IT S.R.L\Flock IT equipo - 03. Federación Patronal\03. FedPat - Discovery ART
# Tamaño máximo por archivo a leer (MB)
LOCAL_MAX_FILE_MB=15
# Límites del índice para consulta/validación (no se carga toda la carpeta en memoria)
LOCAL_MAX_INDEX_FILES=300
LOCAL_MAX_INDEX_MB=60
LOCAL_MAX_SCAN_DIRS=3000

# --- Modo de Jira e IA ----------------------------------------------
# demo -> datos ficticios etiquetados DEMO · real -> integración real (requiere credenciales)
JIRA_MODE=demo
AI_MODE=demo

# --- Jira Cloud (solo lectura) --------------------------------------
# URL del sitio, ej: https://<sitio>.atlassian.net
JIRA_BASE_URL=
# Cuenta con permiso "Browse projects" (idealmente cuenta de servicio de solo lectura)
JIRA_EMAIL=
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Proyectos a consultar (coma). Vacío = todos los que la cuenta pueda ver.
JIRA_PROJECT_KEYS=
# Relación épica -> historia:
#   auto       -> intenta "parent = EPIC" y, si no hay resultados, el campo Epic Link detectado
#   parent     -> usa solo "parent = EPIC" (proyectos team-managed y company-managed actuales)
#   epic_link  -> usa solo el campo indicado en JIRA_EPIC_LINK_FIELD
JIRA_EPIC_LINK_MODE=auto
# Id del campo Epic Link si aplica (ej: customfield_10014). Vacío = autodetección.
JIRA_EPIC_LINK_FIELD=
# Nombre(s) del tipo de issue "épica" (coma). Verificar en Jira: puede ser Epic o Épica.
JIRA_EPIC_ISSUE_TYPES=Epic
# Filtro opcional de tipos hijo (coma). Vacío = se muestran todos los hijos con su tipo.
JIRA_STORY_ISSUE_TYPES=
# Id del campo de criterios de aceptación (ej: customfield_10050). Vacío = autodetección
# por nombre y, si no existe, búsqueda de la sección en la descripción.
JIRA_ACCEPTANCE_CRITERIA_FIELD=
# Campos personalizados a mostrar en el detalle (coma, ids customfield_XXXXX).
JIRA_RELEVANT_FIELDS=

# --- Microsoft (OPCIONAL, desactivado con AUTH_MODE=local) -----------
# Solo se usa con AUTH_MODE=microsoft y/o DOCS_SOURCE=sharepoint. Con el modo local
# estas variables se ignoran y pueden quedar vacías.
# Autenticación:
#   delegated (recomendado) -> iniciás sesión con tu cuenta corporativa; la app ve SOLO
#                              lo que vos podés ver. NO requiere secreto.
#   app                     -> credenciales de aplicación + Sites.Selected (requiere secreto).
SP_AUTH_MODE=delegated
# Datos de la App Registration (los provee IT). No son secretos.
MS_TENANT_ID=
MS_CLIENT_ID=
# Solo para SP_AUTH_MODE=app. Con "delegated" dejalo vacío.
MS_CLIENT_SECRET=
# URI de redirección (debe registrarse igual en la App Registration). Vacío = valor por defecto:
# http://localhost:4000/api/sharepoint/auth/callback
SP_REDIRECT_URI=

# Ubicación documental AUTORIZADA (la única que se consulta).
# Los identificadores (site/drive/carpeta) se resuelven en Microsoft Graph al conectarse.
SP_HOSTNAME=accionait.sharepoint.com
SP_SITE_PATH=/sites/FlockITequipo
# Se acepta el nombre visible de la biblioteca o el segmento de su URL
SP_DRIVE_NAME=Documentos compartidos
SP_FOLDER_PATH=/03. Federación Patronal/03. FedPat - Discovery ART
# Opcional: ids explícitos (tienen prioridad). Dejar vacíos: se resuelven solos.
SP_SITE_ID=
SP_DRIVE_ID=
SP_FOLDER_ITEM_ID=
# Límites para la lectura de contenido (próxima etapa)
SP_MAX_FILES=200
SP_MAX_FILE_MB=15

# --- IA: API de Claude (solo desde el backend) ----------------------
ANTHROPIC_API_KEY=
# Modelo a usar. Ver https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=4000
